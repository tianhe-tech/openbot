# OpenCode API Key (required)
OPENCODE_API_KEY=your-api-key
# Or use OpenCode server password (fallback when OPENCODE_API_KEY is empty)
# OPENCODE_SERVER_PASSWORD=your-server-password

# WeChat Work Configuration (optional)
WECOM_TOKEN=
WECOM_AES_KEY=
WECOM_CORP_ID=
WECOM_AGENT_ID=

# Feishu Configuration (optional)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_USE_WEBSOCKET=true

# DingTalk Configuration (optional)
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_VERIFICATION_TOKEN=
DINGTALK_ENCRYPT_KEY=
DINGTALK_SIGNING_SECRET=

# Server Configuration (optional, defaults provided)
SERVER_ADDR=:8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_GRACE=15s