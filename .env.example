# ╔══════════════════════════════════════════════════════════════╗
# ║  opencode-gateway  环境变量配置                               ║
# ║  复制为 .env 并填写你的实际值: copy .env.example .env          ║
# ╚══════════════════════════════════════════════════════════════╝

# ─── OpenCode 核心配置 ─────────────────────────────────────────
# API Key (优先) 或 Server Password (回退)
OPENCODE_API_KEY=your-api-key
# OPENCODE_SERVER_PASSWORD=your-server-password

# OpenCode serve 端点 (gateway 连接的地址)
OPENCODE_ENDPOINT=http://localhost:4096

# OpenCode 项目目录 (opencode.json 所在目录)
OPENCODE_DIRECTORY=.

# 自动管理 opencode serve 进程 (true=gateway 自动拉起/停止)
OPENCODE_MANAGE_SERVE=true
OPENCODE_SERVE_COMMAND=opencode
OPENCODE_SERVE_ARGS=serve

# ─── 日志 ──────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── HTTP 服务 (webhook 回调用) ────────────────────────────────
HTTP_ENABLED=false
SERVER_ADDR=:8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=300s
SERVER_SHUTDOWN_GRACE=30s

# ─── 记忆系统 (SQLite + MCP) ──────────────────────────────────
# 留空则使用默认路径: <OPENCODE_DIRECTORY>/mem/memory.db
# gateway 启动时会自动在 opencode.json 注册 MCP 记忆工具
MEMORY_STORE_PATH=

# ─── Dev Core (自定义系统提示词) ───────────────────────────────
OPENCODE_DEV_CORE_ENABLED=false
OPENCODE_DEV_CORE_PROMPT=

# ─── 远程代理隧道 (可选) ──────────────────────────────────────
# PROXY_HUB_WS_URL=ws://hub.example.com:18080/ws
# PROXY_KEY_FILE=.opencode-gateway-proxy.json
# PROXY_LOCAL_OPENCODE_ADDR=127.0.0.1:4096
# PROXY_RECONNECT_DELAY=180s

# ═══════════════════════════════════════════════════════════════
#  适配器: 至少启用一个 (企业微信 / 飞书 / 钉钉)
# ═══════════════════════════════════════════════════════════════

# ─── 企业微信 (WeChat Work) ───────────────────────────────────
# WECOM_TOKEN=
# WECOM_AES_KEY=
# WECOM_CORP_ID=
# WECOM_CORP_SECRET=
# WECOM_AGENT_ID=

# ─── 飞书 (Feishu / Lark) ────────────────────────────────────
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=
# FEISHU_USE_WEBSOCKET=true

# ─── 钉钉 (DingTalk) ─────────────────────────────────────────
# Stream 模式 (推荐)
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=

# Webhook 模式 (旧版)
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=
# DINGTALK_VERIFICATION_TOKEN=
# DINGTALK_ENCRYPT_KEY=
# DINGTALK_SIGNING_SECRET=

# 单用户模式 (仅允许 owner 使用)
# DINGTALK_OWNER_USERID=
# DINGTALK_NON_OWNER_PLAN_MODE=false

# ─── 阿里云 NLS 语音识别 (飞书/钉钉语音消息，可选) ────────────
# ALIYUN_NLS_AKID=
# ALIYUN_NLS_AKKEY=
# ALIYUN_NLS_APPKEY=

# ═══════════════════════════════════════════════════════════════
#  Skill 自动生成 (Hermes-style)
# ═══════════════════════════════════════════════════════════════
SKILLGEN_ENABLED=false
# SKILLGEN_DRAFT_MODEL=anthropic/claude-sonnet-4-5
# SKILLGEN_ALTERNATE_MODELS=
# SKILLGEN_EPSILON=0.15
# SKILLGEN_MODEL_SELF_SELECT=true
# SKILLGEN_MAX_PER_DAY=5
# SKILLGEN_ON_HANDOFF=true
# SKILLGEN_ON_LONG_SESSION=true
# SKILLGEN_LONG_SESSION_MIN_TURNS=8
# SKILLGEN_MIN_TOOL_CALLS=3
# SKILLGEN_CANDIDATE_DIR=skills-candidates
# SKILLGEN_INSTALL_DIR=skills
# SKILLGEN_APPROVAL_REQUIRED=true
# SKILLGEN_MIN_CONFIDENCE=0.4
# SKILLGEN_QUEUE_CAPACITY=128
# SKILLGEN_REFERENCE_SKILL=skills/skill-creator/SKILL.md

# ═══════════════════════════════════════════════════════════════
#  离线重试队列
# ═══════════════════════════════════════════════════════════════
RETRY_QUEUE_ENABLED=false
# RETRY_QUEUE_CRON=0 22 * * *
# RETRY_QUEUE_MAX_RETRIES=3
# RETRY_QUEUE_BATCH_SIZE=20